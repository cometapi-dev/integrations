{
  "name": "CometAPI Integrations – OpenClaw Test Environment",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "bash openclaw/.devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.powershell", "timonwong.shellcheck"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
